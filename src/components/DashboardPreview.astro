---
import {
  TrendingUp,
  ShoppingCart,
  Users,
  Clock,
  Sparkles,
  Bell,
  ArrowUpRight,
  ArrowDownRight,
  Brain,
  Target,
  Package,
  DollarSign,
  Boxes,
} from "@lucide/astro";

const topStats = [
  { label: "Today's Revenue", value: "฿128,450", change: "+18.2%", up: true, icon: DollarSign, id: "stat-revenue" },
  { label: "GMV", value: "฿2.4M", change: "+22%", up: true, icon: TrendingUp, id: "stat-gmv" },
  { label: "Orders", value: "342", change: "+9.4%", up: true, icon: ShoppingCart, id: "stat-orders" },
  { label: "Customers", value: "87", change: "+15%", up: true, icon: Users, id: "stat-customers" },
];

const channelStats = [
  { label: "Shopee", orders: 156, pct: 46, color: "bg-orange-500", icon: ShoppingCart },
  { label: "TikTok Shop", orders: 112, pct: 33, color: "bg-pink-500", icon: ShoppingCart },
  { label: "Lazada", orders: 74, pct: 21, color: "bg-blue-500", icon: ShoppingCart },
];

const bars = [35, 52, 48, 72, 58, 88, 65, 92, 70, 85, 60, 78];

const pipeline = [
  { stage: "ลีดใหม่", count: 142, pct: 100 },
  { stage: "ติดต่อแล้ว", count: 98, pct: 69 },
  { stage: "เสนอราคา", count: 54, pct: 38 },
  { stage: "ปิดการขาย", count: 31, pct: 22 },
];

const inventory = [
  { sku: "SKU-2291", name: "เสื้อยืด Cotton", stock: 45, status: "พร้อม", color: "text-primary" },
  { sku: "SKU-1101", name: "รองเท้า Sport", stock: 8, status: "ใกล้หมด", color: "text-amber-500" },
  { sku: "SKU-3302", name: "กระเป๋า Canvas", stock: 120, status: "พร้อม", color: "text-primary" },
];

const activity = [
  { title: "ออเดอร์ใหม่จาก Shopee #SH-8821", time: "1 นาทีที่แล้ว", dot: "bg-orange-500" },
  { title: "AI แนะนำเติมสต๊อก SKU-2291", time: "8 นาทีที่แล้ว", dot: "bg-primary" },
  { title: "ออเดอร์ TikTok Shop #TT-4521 จัดส่งแล้ว", time: "15 นาทีที่แล้ว", dot: "bg-pink-500" },
  { title: "ลูกค้าใหม่: บจก. สยามเทรดดิ้ง", time: "32 นาทีที่แล้ว", dot: "bg-blue-500" },
];
---

<div class="relative w-full animate-float">
  <div
    class="absolute -inset-6 -z-10 rounded-[32px] bg-gradient-to-br from-primary/30 via-secondary/20 to-transparent blur-2xl"
  >
  </div>

  <div class="glass relative rounded-card shadow-2xl shadow-primary/10 overflow-hidden">
    <!-- Browser bar -->
    <div class="flex items-center justify-between border-b border-border/60 px-5 py-4 dark:border-white/10">
      <div class="flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
        <span class="ml-3 text-xs font-medium text-ink/50 dark:text-white/50">CBoom Dashboard</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary"></span>
          Live
        </span>
        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary">
          <Bell class="h-4 w-4" />
        </div>
      </div>
    </div>

    <!-- Top KPI Cards: Revenue, GMV, Orders, Profit -->
    <div class="grid grid-cols-2 gap-3 p-5">
      {
        topStats.map((stat) => (
          <div class="rounded-2xl border border-border/60 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
            <div class="flex items-center justify-between">
              <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <stat.icon class="h-4 w-4" />
              </span>
              <span
                class={`flex items-center gap-0.5 text-xs font-semibold ${
                  stat.up ? "text-primary" : "text-red-500"
                }`}
              >
                {stat.up ? <ArrowUpRight class="h-3 w-3" /> : <ArrowDownRight class="h-3 w-3" />}
                {stat.change}
              </span>
            </div>
            <p class="mt-3 text-xs text-ink/50 dark:text-white/50">{stat.label}</p>
            <p class="text-lg font-bold" data-counter={stat.id}>{stat.value}</p>
          </div>
        ))
      }
    </div>

    <!-- Sales Chart -->
    <div class="mx-5 mb-5 rounded-2xl border border-border/60 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
      <div class="flex items-center justify-between">
        <p class="text-sm font-semibold">Sales — 12 Days</p>
        <span class="flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
          <Sparkles class="h-3 w-3" /> AI Forecast
        </span>
      </div>
      <div class="mt-4 flex h-24 items-end gap-1.5" data-chart>
        {
          bars.map((h, i) => (
            <div
              class="flex-1 rounded-t-md bg-gradient-to-t from-primary to-secondary/70 transition-all duration-700"
              style={`height:${h}%;transition-delay:${i * 50}ms`}
              data-bar={i}
            />
          ))
        }
      </div>
      <div class="mt-2 flex justify-between text-[10px] text-ink/40 dark:text-white/40">
        <span>1 ม.ค.</span>
        <span>12 ม.ค.</span>
      </div>
    </div>

    <!-- Channel Orders: Shopee / TikTok / Lazada -->
    <div class="mx-5 mb-5 rounded-2xl border border-border/60 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
      <p class="mb-3 text-sm font-semibold">Orders by Channel</p>
      <div class="space-y-3">
        {
          channelStats.map((ch) => (
            <div>
              <div class="flex items-center justify-between text-xs">
                <span class="flex items-center gap-2 font-medium text-ink/70 dark:text-white/70">
                  <span class={`h-2 w-2 rounded-full ${ch.color}`} />
                  {ch.label}
                </span>
                <span class="text-ink/50 dark:text-white/50">{ch.orders} ออเดอร์</span>
              </div>
              <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-border/60 dark:bg-white/10">
                <div class={`h-full rounded-full ${ch.color} transition-all duration-1000`} style={`width:${ch.pct}%`} />
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Pipeline + Inventory + POS -->
    <div class="mx-5 mb-5 grid grid-cols-3 gap-3">
      <div class="rounded-2xl border border-border/60 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
        <div class="flex items-center gap-2">
          <Target class="h-4 w-4 text-primary" />
          <p class="text-xs font-semibold">Sales Pipeline</p>
        </div>
        <div class="mt-2 space-y-1.5">
          {
            pipeline.map((stage) => (
              <div class="flex items-center justify-between text-[10px]">
                <span class="text-ink/60 dark:text-white/60">{stage.stage}</span>
                <span class="font-semibold">{stage.count}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="rounded-2xl border border-border/60 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
        <div class="flex items-center gap-2">
          <Boxes class="h-4 w-4 text-primary" />
          <p class="text-xs font-semibold">Warehouse</p>
        </div>
        <div class="mt-2 space-y-1.5">
          {
            inventory.map((item) => (
              <div class="flex items-center justify-between text-[10px]">
                <span class="text-ink/60 dark:text-white/60">{item.sku}</span>
                <span class={`font-semibold ${item.color}`}>{item.stock}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="rounded-2xl border border-amber-500/30 bg-amber-50 p-4 dark:bg-amber-500/5">
        <div class="flex items-center gap-2">
          <Package class="h-4 w-4 text-amber-500" />
          <p class="text-xs font-semibold text-amber-600 dark:text-amber-400">Stock Alert</p>
        </div>
        <div class="mt-2 space-y-1.5">
          <div class="flex items-center justify-between text-[10px]">
            <span class="text-ink/60 dark:text-white/60">SKU-1101</span>
            <span class="font-semibold text-amber-500">8 left</span>
          </div>
          <div class="flex items-center justify-between text-[10px]">
            <span class="text-ink/60 dark:text-white/60">SKU-4478</span>
            <span class="font-semibold text-amber-500">3 left</span>
          </div>
          <div class="flex items-center justify-between text-[10px]">
            <span class="text-ink/60 dark:text-white/60">SKU-5520</span>
            <span class="font-semibold text-red-500">Out</span>
          </div>
        </div>
      </div>
    </div>

    <!-- AI Insight -->
    <div class="mx-5 mb-5 rounded-2xl border border-primary/30 bg-primary/5 p-4">
      <div class="flex items-center gap-2">
        <Brain class="h-4 w-4 text-primary" />
        <p class="text-xs font-semibold text-primary">AI Insight & Forecast</p>
      </div>
      <p class="mt-2 text-xs leading-relaxed text-ink/70 dark:text-white/70">
        Sales forecast: +22% next week. Recommend restocking 5 items before Friday.
      </p>
    </div>

    <!-- Activity Feed -->
    <div class="mx-5 mb-5 rounded-2xl border border-border/60 bg-white/70 p-4 dark:border-white/10 dark:bg-white/5">
      <p class="mb-3 text-sm font-semibold">Recent Orders</p>
      <ul class="space-y-2.5" data-activity>
        {
          activity.map((item) => (
            <li class="flex items-center justify-between text-xs">
              <span class="flex items-center gap-2 text-ink/70 dark:text-white/70">
                <span class={`h-1.5 w-1.5 rounded-full ${item.dot}`} />
                {item.title}
              </span>
              <span class="text-ink/40 dark:text-white/40">{item.time}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- Floating AI card -->
  <div
    class="glass absolute -left-6 -bottom-6 hidden w-52 rounded-2xl p-4 shadow-xl sm:block animate-[float_7s_ease-in-out_infinite]"
  >
    <div class="flex items-center gap-2">
      <Brain class="h-4 w-4 text-primary" />
      <p class="text-xs font-medium text-ink/50 dark:text-white/50">คำแนะนำจาก AI</p>
    </div>
    <p class="mt-1 text-sm font-semibold">ควรเติมสต๊อก "SKU-2291" ก่อนวันศุกร์</p>
  </div>

  <!-- Floating notification card -->
  <div
    class="glass absolute -right-4 -top-6 hidden w-44 rounded-2xl p-3 shadow-xl sm:block animate-[float_5s_ease-in-out_infinite_0.5s]"
  >
    <p class="text-xs font-medium text-ink/50 dark:text-white/50">การแจ้งเตือน</p>
    <p class="mt-1 text-sm font-semibold text-primary">+248 ออเดอร์ใหม่วันนี้</p>
  </div>
</div>

<script is:inline>
  // Realtime bar chart animation
  (function () {
    const chart = document.querySelector('[data-chart]');
    if (!chart) return;
    const bars = chart.querySelectorAll('[data-bar]');
    setInterval(() => {
      bars.forEach((bar) => {
        const h = 30 + Math.random() * 65;
        bar.style.height = h + '%';
      });
    }, 3000);
  })();

  // Activity feed rotation
  (function () {
    const feed = document.querySelector('[data-activity]');
    if (!feed) return;
    const items = feed.querySelectorAll('li');
    let idx = 0;
    setInterval(() => {
      items.forEach((li) => (li.style.opacity = '0.5'));
      items[idx].style.opacity = '1';
      idx = (idx + 1) % items.length;
    }, 2500);
  })();
</script>
