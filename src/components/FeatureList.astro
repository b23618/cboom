---
interface FeatureItem {
  icon: any;
  title: string;
  description: string;
}

interface Props {
  items: FeatureItem[];
}

const { items } = Astro.props;
---

<section class="py-16 sm:py-20">
  <div class="container-page grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item, i) => (
        <div
          class="reveal rounded-card border border-border/70 bg-white p-7 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/10 dark:border-white/10 dark:bg-white/5"
          style={`transition-delay:${i * 70}ms`}
        >
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <item.icon class="h-5 w-5" />
          </span>
          <h3 class="mt-4 font-bold">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink/60 dark:text-white/60">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
