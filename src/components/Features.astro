---
import {
  Users2,
  Store,
  Warehouse,
  ScanLine,
  Bot,
  FileBarChart,
  Workflow,
  Code,
  Webhook,
  LayoutDashboard,
  ShieldCheck,
  ScrollText,
} from "@lucide/astro";

const features = [
  { icon: Users2, title: "CRM", description: "จัดการลูกค้า ลีด และ Pipeline ในที่เดียว" },
  { icon: Store, title: "Marketplace", description: "ขายบน Shopee, TikTok Shop และ Lazada จากหน้าจอเดียว" },
  { icon: Warehouse, title: "Warehouse", description: "ติดตามสต๊อกทุกคลังและทุกช่องทางแบบเรียลไทม์" },
  { icon: ScanLine, title: "POS", description: "จุดขายหน้าร้านเชื่อมต่อสต๊อกและ CRM ได้ทันที" },
  { icon: Bot, title: "AI", description: "AI สรุปยอดขาย พยากรณ์ และแนะนำการตัดสินใจ" },
  { icon: FileBarChart, title: "Reports", description: "สร้างรายงานธุรกิจและ ESG ได้ในคลิกเดียว" },
  { icon: Workflow, title: "Automation", description: "ให้ระบบทำงานซ้ำซากแทนทีมของคุณโดยไม่ต้องเขียนโค้ด" },
  { icon: Code, title: "REST API", description: "API แบบ RESTful ครบทุก Endpoint สำหรับจัดการทุกอย่าง" },
  { icon: Webhook, title: "Webhook", description: "รับ Event แบบเรียลไทม์เมื่อมีออเดอร์ใหม่หรือสต๊อกเปลี่ยน" },
  { icon: LayoutDashboard, title: "Dashboard", description: "ดูยอดขาย ออเดอร์ และ KPI อัปเดตสดทุกช่วงเวลา" },
  { icon: ShieldCheck, title: "Role Permission", description: "กำหนดสิทธิ์ผู้ใช้งานระดับละเอียด ปลอดภัยระดับองค์กร" },
  { icon: ScrollText, title: "Audit Log", description: "บันทึกทุกการกระทำในระบบ ตรวจสอบย้อนหลังได้" },
];
---

<section id="features" class="bg-white py-24 sm:py-32 dark:bg-white/[0.02]">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">ฟีเจอร์</span>
      <h2 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl">ทุกเครื่องมือที่ธุรกิจต้องการ</h2>
      <p class="mt-4 text-lg text-ink/60 dark:text-white/60">
        ครบทุกฟังก์ชันในแพลตฟอร์มเดียว ไม่ต้องเสียเงินซื้อหลายระบบ
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((feature, i) => (
          <div
            class="reveal group rounded-card border border-border/70 bg-background p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:bg-white hover:shadow-lg hover:shadow-primary/10 dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10"
            style={`transition-delay:${i * 60}ms`}
          >
            <span
              class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary transition-transform duration-300 group-hover:scale-110 group-hover:bg-primary group-hover:text-white"
            >
              <feature.icon class="h-5 w-5" />
            </span>
            <h3 class="mt-4 font-bold">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/60 dark:text-white/60">{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
