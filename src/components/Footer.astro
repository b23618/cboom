---
import { MessageCircle, Briefcase, Code } from "@lucide/astro";
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const columns = [
  {
    title: "Products",
    links: [
      { label: "CRM", href: "/crm/" },
      { label: "Marketplace", href: "/marketplace/" },
      { label: "Warehouse", href: "/inventory/" },
      { label: "POS", href: "#products" },
      { label: "AI", href: "/ai/" },
      { label: "ESG", href: "/esg/" },
    ],
  },
  {
    title: "Solutions",
    links: [
      { label: "Retail", href: "#case-studies" },
      { label: "Wholesale", href: "#case-studies" },
      { label: "Factory", href: "#case-studies" },
      { label: "SME", href: "#case-studies" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "Documentation", href: "#api" },
      { label: "API", href: "#api" },
      { label: "Blog", href: "/rss.xml" },
      { label: "Roadmap", href: "#" },
      { label: "Changelog", href: "#" },
      { label: "Status", href: "#" },
      { label: "Security", href: "#security" },
    ],
  },
  {
    title: "บริษัท",
    links: [
      { label: "เกี่ยวกับเรา", href: "#" },
      { label: "ราคา", href: "/pricing/" },
      { label: "ติดต่อเรา", href: "/contact/" },
      { label: "ร่วมงานกับเรา", href: "#" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border/70 bg-white py-16 dark:border-white/10 dark:bg-white/[0.02]">
  <div class="container-page">
    <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:grid-cols-6">
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2 font-extrabold text-lg tracking-tight">
          <Image src={logo} alt="CBoom" class="h-9 w-9 rounded-xl object-contain" width={36} height={36} />
          <span>CBoom</span>
        </a>
        <p class="mt-4 text-sm font-medium text-primary">Business Automation Platform</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink/60 dark:text-white/60">
          One Platform. Unlimited Possibilities. บริหารธุรกิจของคุณได้จากระบบเดียว
        </p>
        <div class="mt-6 flex items-center gap-3">
          <a href="#" aria-label="Twitter" class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink/60 transition-colors hover:border-primary/40 hover:text-primary dark:border-white/10 dark:text-white/60">
            <MessageCircle class="h-4 w-4" />
          </a>
          <a href="#" aria-label="LinkedIn" class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink/60 transition-colors hover:border-primary/40 hover:text-primary dark:border-white/10 dark:text-white/60">
            <Briefcase class="h-4 w-4" />
          </a>
          <a href="#" aria-label="GitHub" class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink/60 transition-colors hover:border-primary/40 hover:text-primary dark:border-white/10 dark:text-white/60">
            <Code class="h-4 w-4" />
          </a>
        </div>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="text-sm font-semibold">{col.title}</p>
            <ul class="mt-4 space-y-3">
              {
                col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-ink/60 transition-colors hover:text-primary dark:text-white/60"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-border/60 pt-8 text-sm text-ink/50 dark:border-white/10 dark:text-white/40 sm:flex-row">
      <p>&copy; {year} CBoom สงวนลิขสิทธิ์ทุกประการ</p>
      <p>ออกแบบมาเพื่อธุรกิจที่ต้องการเติบโตเร็ว</p>
    </div>
  </div>
</footer>
