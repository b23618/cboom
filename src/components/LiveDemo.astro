---
import { ArrowRight, PlayCircle, MousePointerClick } from "@lucide/astro";
---

<section id="live-demo" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="reveal grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <span class="section-eyebrow">
          <MousePointerClick class="h-3.5 w-3.5" />
          Live Demo
        </span>
        <h2 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl">
          ลองใช้ CBoom ได้ทันที
          <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
            ไม่ต้องสมัคร
          </span>
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink/60 dark:text-white/60">
          สำรวจฟีเจอร์ทุกโมดูลของ CBoom ผ่าน Interactive Demo — ดู Dashboard, CRM, Marketplace และ AI Insights
          แบบเรียลไทม์ พร้อมข้อมูลตัวอย่างที่ใกล้เคียงธุรกิจจริง
        </p>

        <ul class="mt-8 space-y-3">
          <li class="flex items-center gap-3 text-sm text-ink/70 dark:text-white/70">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-primary">
              <PlayCircle class="h-3.5 w-3.5" />
            </span>
            ทดลองครบทุกโมดูล — CRM, Marketplace, AI, ESG
          </li>
          <li class="flex items-center gap-3 text-sm text-ink/70 dark:text-white/70">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-primary">
              <PlayCircle class="h-3.5 w-3.5" />
            </span>
            ข้อมูลตัวอย่างพร้อมใช้ ไม่ต้องตั้งค่า
          </li>
          <li class="flex items-center gap-3 text-sm text-ink/70 dark:text-white/70">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-primary">
              <PlayCircle class="h-3.5 w-3.5" />
            </span>
            เปลี่ยนมุมมอง Dashboard ได้ตามใจ
          </li>
        </ul>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href="/demo/" class="btn-primary">
            เริ่มทดลองใช้
            <ArrowRight class="h-4 w-4" />
          </a>
          <a href="https://lin.ee/QVWxues" class="btn-secondary">
            <PlayCircle class="h-4 w-4" />
            นัดหมายสาธิตระบบ
          </a>
        </div>
      </div>

      <!-- Demo preview frame -->
      <div class="reveal">
        <div class="relative w-full animate-float">
          <div
            class="absolute -inset-6 -z-10 rounded-[32px] bg-gradient-to-br from-primary/30 via-secondary/20 to-transparent blur-2xl"
          >
          </div>
          <div class="glass relative rounded-card shadow-2xl shadow-primary/10 overflow-hidden">
            <div class="flex items-center justify-between border-b border-border/60 px-5 py-4 dark:border-white/10">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
                <span class="ml-3 text-xs font-medium text-ink/50 dark:text-white/50">demo.cboom.io</span>
              </div>
              <span class="flex items-center gap-1 rounded-full bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
                <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-primary"></span>
                Demo
              </span>
            </div>
            <div class="p-6">
              <div class="flex gap-2 border-b border-border/60 pb-3 dark:border-white/10">
                <button class="rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-semibold text-primary">Dashboard</button>
                <button class="rounded-lg px-3 py-1.5 text-xs font-medium text-ink/50 dark:text-white/50">CRM</button>
                <button class="rounded-lg px-3 py-1.5 text-xs font-medium text-ink/50 dark:text-white/50">Marketplace</button>
                <button class="rounded-lg px-3 py-1.5 text-xs font-medium text-ink/50 dark:text-white/50">AI</button>
              </div>
              <div class="mt-4 grid grid-cols-3 gap-3">
                <div class="rounded-xl border border-border/60 bg-white/70 p-3 dark:border-white/10 dark:bg-white/5">
                  <p class="text-[10px] text-ink/50 dark:text-white/50">ยอดขาย</p>
                  <p class="mt-1 text-sm font-bold">฿128,450</p>
                </div>
                <div class="rounded-xl border border-border/60 bg-white/70 p-3 dark:border-white/10 dark:bg-white/5">
                  <p class="text-[10px] text-ink/50 dark:text-white/50">ออเดอร์</p>
                  <p class="mt-1 text-sm font-bold">342</p>
                </div>
                <div class="rounded-xl border border-border/60 bg-white/70 p-3 dark:border-white/10 dark:bg-white/5">
                  <p class="text-[10px] text-ink/50 dark:text-white/50">ลูกค้าใหม่</p>
                  <p class="mt-1 text-sm font-bold">87</p>
                </div>
              </div>
              <div class="mt-3 flex h-20 items-end gap-1.5">
                {
                  [40, 65, 50, 80, 55, 90, 70, 85].map((h) => (
                    <div class="flex-1 rounded-t-md bg-gradient-to-t from-primary to-secondary/70" style={`height:${h}%`} />
                  ))
                }
              </div>
              <div class="mt-4 rounded-xl border border-primary/30 bg-primary/5 p-3">
                <p class="text-xs font-semibold text-primary">AI Insight</p>
                <p class="mt-1 text-[11px] text-ink/70 dark:text-white/70">ยอดขายคาดเพิ่ม 22% สัปดาห์หน้า</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
