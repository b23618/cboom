---
import { Menu, X, Sun, Moon, ArrowRight } from "@lucide/astro";

const navItems = [
  { label: "หน้าแรก", href: "/" },
  { label: "ผลิตภัณฑ์", href: "/#products" },
  { label: "โซลูชัน", href: "/#features" },
  { label: "ราคา", href: "/#pricing" },
  { label: "ลูกค้าของเรา", href: "/#testimonials" },
  { label: "บทความ", href: "/#faq" },
  { label: "ติดต่อเรา", href: "/#contact" },
];
---

<header class="sticky top-0 z-50 w-full">
  <nav
    id="navbar"
    class="container-page mt-4 flex items-center justify-between rounded-full border border-border/70 bg-white/70 px-4 py-3 shadow-sm shadow-black/[0.02] backdrop-blur-xl transition-all duration-300 dark:border-white/10 dark:bg-white/5 sm:px-6"
  >
    <a href="/" class="flex items-center gap-2 font-extrabold text-lg tracking-tight">
      <img src="/logo.png" alt="CBoom" class="h-9 w-9 rounded-xl object-contain" width="36" height="36" />
      <span>CBoom</span>
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-full px-4 py-2 text-sm font-medium text-ink/70 transition-colors hover:bg-primary/5 hover:text-primary dark:text-white/70 dark:hover:bg-white/10 dark:hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="hidden items-center gap-3 lg:flex">
      <button
        id="theme-toggle"
        aria-label="สลับโหมดสี"
        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink/70 transition-colors hover:border-primary/40 hover:text-primary dark:border-white/10 dark:text-white/70"
      >
        <Sun class="hidden h-4 w-4 dark:block" />
        <Moon class="block h-4 w-4 dark:hidden" />
      </button>
      <a href="/#contact" class="btn-primary !px-5 !py-2.5 text-sm">
        ทดลองใช้ฟรี
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>

    <button id="menu-toggle" aria-label="เปิดเมนู" class="flex h-9 w-9 items-center justify-center lg:hidden">
      <Menu class="h-6 w-6" id="menu-icon-open" />
      <X class="hidden h-6 w-6" id="menu-icon-close" />
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="container-page hidden pointer-events-none opacity-0 transition-all duration-300"
  >
    <div class="mt-2 flex flex-col gap-1 rounded-3xl border border-border/70 bg-white/90 p-4 shadow-xl backdrop-blur-xl dark:border-white/10 dark:bg-[#0a0f0d]/95">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-2xl px-4 py-3 text-sm font-medium text-ink/80 hover:bg-primary/5 hover:text-primary dark:text-white/80 dark:hover:bg-white/10"
          >
            {item.label}
          </a>
        ))
      }
      <div class="mt-2 flex items-center gap-3 border-t border-border/70 pt-4 dark:border-white/10">
        <button
          id="theme-toggle-mobile"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-border dark:border-white/10"
          aria-label="สลับโหมดสี"
        >
          <Sun class="hidden h-4 w-4 dark:block" />
          <Moon class="block h-4 w-4 dark:hidden" />
        </button>
        <a href="/#contact" class="btn-primary flex-1 !py-2.5 text-sm">ทดลองใช้ฟรี</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  function setupNavbar() {
    const toggles = [document.getElementById("theme-toggle"), document.getElementById("theme-toggle-mobile")];
    toggles.forEach((btn) => {
      btn?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("cboom-theme", isDark ? "dark" : "light");
      });
    });

    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    menuToggle?.addEventListener("click", () => {
      const isHidden = mobileMenu?.classList.contains("hidden");
      if (isHidden) {
        mobileMenu?.classList.remove("hidden", "pointer-events-none", "opacity-0");
        iconOpen?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
      } else {
        mobileMenu?.classList.add("pointer-events-none", "opacity-0");
        setTimeout(() => mobileMenu?.classList.add("hidden"), 200);
        iconOpen?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
      }
    });

    const nav = document.getElementById("navbar");
    window.addEventListener("scroll", () => {
      if (window.scrollY > 12) {
        nav?.classList.add("shadow-lg", "shadow-black/5");
      } else {
        nav?.classList.remove("shadow-lg", "shadow-black/5");
      }
    });
  }
  setupNavbar();
</script>
