---
import { Check, Star, Cloud, Wrench } from "@lucide/astro";

const saasPlans = [
  {
    name: "Starter",
    price: "990",
    period: "บาท/เดือน",
    description: "เริ่มต้นสำหรับร้านค้าขนาดเล็ก",
    popular: false,
    features: [
      "CRM สำหรับ 3 ผู้ใช้",
      "เชื่อมต่อ 1 ช่องทาง Marketplace",
      "Dashboard พื้นฐาน",
      "รายงานยอดขายรายเดือน",
      "ซัพพอร์ตทาง LINE OA",
    ],
  },
  {
    name: "Growth",
    price: "2,900",
    period: "บาท/เดือน",
    description: "สำหรับธุรกิจที่กำลังเติบโต",
    popular: true,
    features: [
      "CRM สำหรับ 10 ผู้ใช้",
      "เชื่อมต่อ Shopee / TikTok Shop / Lazada",
      "AI Insights & Sales Forecast",
      "ซิงค์สต๊อกและออเดอร์อัตโนมัติ",
      "รายงานแบบกำหนดเอง",
      "ซัพพอร์ต Priority",
    ],
  },
  {
    name: "Enterprise",
    price: "ราคาพิเศษ",
    period: "ออกแบบตามความต้องการ",
    description: "สำหรับองค์กรขนาดใหญ่",
    popular: false,
    features: [
      "ผู้ใช้ไม่จำกัด",
      "เชื่อมต่อทุกช่องทาง + API",
      "CBoom ESG และรายงานความยั่งยืน",
      "ทีมดูแลลูกค้าเฉพาะองค์กร",
      "SLA 99.9% Uptime",
      "On-premise / Private Cloud",
    ],
  },
];

const proServices = [
  {
    name: "Onboarding & Setup",
    price: "15,000",
    period: "บาท / ครั้ง",
    description: "ตั้งค่าระบบเริ่มต้น นำเข้าข้อมูล อบรมทีม",
    features: [
      "ตั้งค่า CRM และ Marketplace",
      "นำเข้าข้อมูลลูกค้าและสินค้า",
      "อบรมทีมขาย 2 ชั่วโมง",
      "ปรับแต่ง Dashboard",
    ],
  },
  {
    name: "Custom Integration",
    price: "50,000",
    period: "บาท / โปรเจกต์",
    description: "เชื่อมต่อระบบเดิมเข้ากับ CBoom",
    features: [
      "เชื่อมต่อ ERP / Accounting",
      "พัฒนา API เฉพาะทาง",
      "ตั้งค่า Webhook และ Automation",
      "ทดสอบและส่งมอบ 30 วัน",
    ],
  },
  {
    name: "Dedicated Support",
    price: "10,000",
    period: "บาท / เดือน",
    description: "ทีมงานดูแลเฉพาะทีม",
    features: [
      "Account Manager เฉพาะทาง",
      "ตอบกลับภายใน 2 ชั่วโมง",
      "ตรวจสอบระบบรายสัปดาห์",
      "ปรับปรุงและอัปเดตตามต้องการ",
    ],
  },
];
---

<section id="pricing" class="py-24 sm:py-32">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">ราคา</span>
      <h2 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl">
        แพ็กเกจราคาที่เติบโตไปพร้อมธุรกิจคุณ
      </h2>
      <p class="mt-4 text-lg text-ink/60 dark:text-white/60">
        เลือกแพ็กเกจ Cloud SaaS หรือเพิ่ม Professional Services ตามความต้องการ
      </p>
    </div>

    <!-- Cloud SaaS -->
    <div class="reveal mt-12">
      <div class="flex items-center justify-center gap-2">
        <Cloud class="h-5 w-5 text-primary" />
        <h3 class="text-xl font-bold">Cloud SaaS</h3>
      </div>
      <p class="mt-2 text-center text-sm text-ink/50 dark:text-white/50">สมัครใช้งานออนไลน์ เริ่มต้นภายใน 5 นาที</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        saasPlans.map((plan, i) => (
          <div
            class={`reveal relative flex flex-col rounded-card border p-8 transition-all duration-300 hover:-translate-y-1.5 ${
              plan.popular
                ? "border-primary/40 bg-gradient-to-b from-primary/5 to-transparent shadow-xl shadow-primary/15"
                : "border-border/70 bg-white dark:border-white/10 dark:bg-white/5"
            }`}
            style={`transition-delay:${i * 100}ms`}
          >
            {plan.popular && (
              <span class="absolute -top-3 left-1/2 flex -translate-x-1/2 items-center gap-1 rounded-full bg-primary px-4 py-1 text-xs font-bold text-white shadow-md">
                <Star class="h-3 w-3" /> ยอดนิยม
              </span>
            )}
            <h4 class="text-lg font-bold">{plan.name}</h4>
            <p class="mt-2 text-sm text-ink/60 dark:text-white/60">
              {plan.description}
            </p>
            <div class="mt-6 flex items-baseline gap-1">
              <span class="text-4xl font-extrabold">
                {plan.price === "ราคาพิเศษ" ? plan.price : `฿${plan.price}`}
              </span>
            </div>
            <p class="text-sm text-ink/50 dark:text-white/50">{plan.period}</p>

            <ul class="mt-6 flex-1 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm text-ink/70 dark:text-white/70">
                  <Check class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" />
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href="https://lin.ee/QVWxues"
              class={`mt-8 ${plan.popular ? "btn-primary" : "btn-secondary"} w-full`}
            >
              {plan.price === "ราคาพิเศษ" ? "ติดต่อฝ่ายขาย" : "ทดลองใช้ฟรี"}
            </a>
          </div>
        ))
      }
    </div>

    <!-- Professional Services -->
    <div class="reveal mt-20">
      <div class="flex items-center justify-center gap-2">
        <Wrench class="h-5 w-5 text-primary" />
        <h3 class="text-xl font-bold">Professional Services</h3>
      </div>
      <p class="mt-2 text-center text-sm text-ink/50 dark:text-white/50">บริการโดยทีมงานผู้เชี่ยวชาญของ CBoom</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        proServices.map((service, i) => (
          <div
            class="reveal relative flex flex-col rounded-card border border-border/70 bg-white p-8 transition-all duration-300 hover:-translate-y-1.5 hover:border-primary/30 hover:shadow-lg dark:border-white/10 dark:bg-white/5"
            style={`transition-delay:${i * 100}ms`}
          >
            <h4 class="text-lg font-bold">{service.name}</h4>
            <p class="mt-2 text-sm text-ink/60 dark:text-white/60">
              {service.description}
            </p>
            <div class="mt-6 flex items-baseline gap-1">
              <span class="text-3xl font-extrabold">฿{service.price}</span>
            </div>
            <p class="text-sm text-ink/50 dark:text-white/50">{service.period}</p>

            <ul class="mt-6 flex-1 space-y-3">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm text-ink/70 dark:text-white/70">
                  <Check class="mt-0.5 h-4 w-4 flex-shrink-0 text-primary" />
                  {feature}
                </li>
              ))}
            </ul>

            <a
              href="https://lin.ee/QVWxues"
              class="btn-secondary mt-8 w-full"
            >
              ขอใบเสนอราคา
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
