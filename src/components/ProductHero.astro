---
import { ArrowRight } from "@lucide/astro";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  icon: any;
}

const { eyebrow, title, description, icon: Icon } = Astro.props;
---

<section class="relative overflow-hidden pt-20 pb-20 sm:pt-28 sm:pb-24">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-primary/10 via-background to-secondary/5 dark:from-primary/15 dark:via-[#0a0f0d] dark:to-secondary/5"
  >
  </div>

  <div class="container-page reveal mx-auto max-w-3xl text-center">
    <span
      class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-primary to-secondary text-white shadow-lg shadow-primary/30"
    >
      <Icon class="h-8 w-8" />
    </span>
    <span class="section-eyebrow mt-6">{eyebrow}</span>
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-ink/60 dark:text-white/60">{description}</p>
    <a href="https://lin.ee/QVWxues" class="btn-primary mt-10">
      ทดลองใช้ฟรี
      <ArrowRight class="h-4 w-4" />
    </a>
  </div>
</section>
