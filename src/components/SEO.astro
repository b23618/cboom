---
export interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
  type?: "website" | "article";
  noindex?: boolean;
  breadcrumb?: { name: string; path: string }[];
  faq?: { question: string; answer: string }[];
}

const {
  title,
  description,
  image,
  keywords = "CBoom, ระบบ CRM, ระบบบริหารธุรกิจอัตโนมัติ, เชื่อมต่อมาร์เก็ตเพลส, Shopee, TikTok Shop, Lazada, ระบบคลังสินค้า, AI อัตโนมัติ, รายงาน ESG, Business Automation Platform",
  type = "website",
  noindex = false,
  breadcrumb = [],
  faq = [],
} = Astro.props;

const site = Astro.site ?? new URL("https://cboom.in.th");
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = image ? new URL(image, site) : new URL(`/og/${Astro.url.pathname === "/" ? "home" : Astro.url.pathname.split("/").filter(Boolean)[0] ?? "home"}`, site);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CBoom",
  url: site.href,
  logo: new URL("/logo.png", site).href,
  description: "แพลตฟอร์มบริหารธุรกิจอัตโนมัติครบวงจร รวม CRM มาร์เก็ตเพลส AI Dashboard และระบบอัตโนมัติ",
  sameAs: [
    "https://lin.ee/QVWxues",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "sales",
    email: "hello@cboom.in.th",
    availableLanguage: ["Thai", "English"],
  },
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CBoom",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  offers: {
    "@type": "AggregateOffer",
    lowPrice: "0",
    highPrice: "50000",
    priceCurrency: "THB",
    offerCount: "6",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    ratingCount: "500",
  },
};

const breadcrumbSchema =
  breadcrumb.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumb.map((item, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: item.name,
          item: new URL(item.path, site).href,
        })),
      }
    : null;

const faqSchema =
  faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((q) => ({
          "@type": "Question",
          name: q.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: q.answer,
          },
        })),
      }
    : null;
---

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="CBoom" />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<meta name="theme-color" content="#16A34A" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="CBoom" />
<meta property="og:locale" content="th_TH" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
