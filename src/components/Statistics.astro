---
const stats = [
  { value: "80%", label: "ลดเวลาทำงานซ้ำ" },
  { value: "90%", label: "ลดการกรอกข้อมูล Manual" },
  { value: "24 ชั่วโมง", label: "ข้อมูลอัปเดตอัตโนมัติ" },
];
---

<section class="py-16 sm:py-20">
  <div class="container-page">
    <div class="reveal grid grid-cols-1 gap-6 rounded-card border border-border/70 bg-white p-10 text-center sm:grid-cols-3 dark:border-white/10 dark:bg-white/5">
      {
        stats.map((stat) => (
          <div>
            <p class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-4xl font-extrabold text-transparent sm:text-5xl">
              {stat.value}
            </p>
            <p class="mt-2 text-sm text-ink/60 dark:text-white/60">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
