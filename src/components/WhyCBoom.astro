---
import { Clock, Plug, AlertCircle, Activity, TrendingUp, Code } from "@lucide/astro";

const columns = [
  {
    icon: Clock,
    title: "ลดเวลาการทำงานซ้ำ",
    description: "อัตโนมัติงานที่ทำซ้ำทุกวัน ให้ทีมของคุณโฟกัสกับลูกค้าได้มากขึ้น",
  },
  {
    icon: Plug,
    title: "เชื่อมทุกระบบ",
    description: "เชื่อม Marketplace, ERP, Accounting และระบบเดิมของธุรกิจได้ในไม่กี่ขั้นตอน",
  },
  {
    icon: AlertCircle,
    title: "ลดความผิดพลาด",
    description: "ข้อมูลไหลอัตโนมัติระหว่างระบบ ลดการกรอกข้อมือและความผิดพลาดจาก Human Error",
  },
  {
    icon: Activity,
    title: "ข้อมูลแบบ Real-time",
    description: "เห็นภาพรวมธุรกิจได้ทันที ตัดสินใจได้เร็วกว่าเดิมด้วย Dashboard แบบเรียลไทม์",
  },
  {
    icon: TrendingUp,
    title: "ขยายระบบได้ในอนาคต",
    description: "ขยายทีมขาย เพิ่มสาขา หรือเปิดช่องทางใหม่ได้โดยไม่ต้องเปลี่ยนระบบ",
  },
  {
    icon: Code,
    title: "API พร้อมเชื่อมต่อ",
    description: "REST API และ Webhook พร้อมใช้งาน เชื่อมต่อกับระบบภายนอกได้อย่างยืดหยุ่น",
  },
];
---

<section class="bg-white py-24 sm:py-32 dark:bg-white/[0.02]">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="section-eyebrow">ทำไมต้อง CBoom</span>
      <h2 class="mt-6 text-3xl font-extrabold tracking-tight sm:text-4xl">ทุกสิ่งที่ธุรกิจต้องการ ในแพลตฟอร์มเดียว</h2>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        columns.map((col, i) => (
          <div
            class="reveal rounded-card border border-border/70 bg-background p-8 dark:border-white/10 dark:bg-white/5"
            style={`transition-delay:${i * 80}ms`}
          >
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary">
              <col.icon class="h-7 w-7" />
            </span>
            <h3 class="mt-5 text-lg font-bold">{col.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/60 dark:text-white/60">{col.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
