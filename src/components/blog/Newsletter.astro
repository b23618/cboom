---
import { Mail, CheckCircle } from "@lucide/astro";
---

<section class="py-16">
  <div class="container-page">
    <div class="mx-auto max-w-4xl">
      <div class="relative overflow-hidden rounded-card border border-border/70 bg-white p-8 dark:border-white/10 dark:bg-white/5">
        <div class="pointer-events-none absolute -top-20 -right-20 h-56 w-56 rounded-full bg-primary/5 blur-3xl"></div>
        <div class="relative grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-center">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/5 px-4 py-1.5 text-sm font-medium text-primary">
              <Mail class="h-3.5 w-3.5" />
              Newsletter
            </span>
            <h2 class="mt-4 text-2xl font-extrabold tracking-tight">รับความรู้ธุรกิจใหม่ๆ ทุกสัปดาห์</h2>
            <p class="mt-3 text-sm leading-relaxed text-ink/60 dark:text-white/60">
              บทความ คู่มือ และเคล็ดลับเกี่ยวกับ ERP CRM Marketplace Warehouse POS และ AI สำหรับธุรกิจไทย ส่งตรงถึงอีเมลคุณ
            </p>
            <ul class="mt-4 space-y-2">
              <li class="flex items-center gap-2 text-sm text-ink/70 dark:text-white/70">
                <CheckCircle class="h-4 w-4 text-primary" />
                บทความใหม่ทุกสัปดาห์
              </li>
              <li class="flex items-center gap-2 text-sm text-ink/70 dark:text-white/70">
                <CheckCircle class="h-4 w-4 text-primary" />
                ไม่มีสแปม ยกเลิกได้ทุกเมื่อ
              </li>
              <li class="flex items-center gap-2 text-sm text-ink/70 dark:text-white/70">
                <CheckCircle class="h-4 w-4 text-primary" />
                ฟรี ไม่มีค่าใช้จ่าย
              </li>
            </ul>
          </div>
          <div>
            <form id="newsletter-form" class="space-y-3">
              <input
                type="email"
                id="newsletter-email"
                required
                placeholder="กรอกอีเมลของคุณ"
                class="w-full rounded-xl border border-border bg-white px-4 py-3 text-sm font-medium text-ink outline-none transition-colors focus:border-primary dark:border-white/10 dark:bg-white/5 dark:text-white"
              />
              <button type="submit" class="btn-primary w-full justify-center text-sm">
                สมัครรับข่าวสาร
              </button>
              <p id="newsletter-msg" class="hidden rounded-xl bg-primary/10 px-4 py-3 text-sm font-medium text-primary">
                ขอบคุณ! กรุณาตรวจสอบอีเมลเพื่อยืนยันการสมัคร
              </p>
              <p class="text-xs text-ink/40 dark:text-white/40">
                การสมัครถือว่าคุณยอมรับ <a href="/privacy/" class="underline">นโยบายความเป็นส่วนตัว</a>
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const form = document.getElementById('newsletter-form');
    const msg = document.getElementById('newsletter-msg');
    if (!form || !msg) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      msg.classList.remove('hidden');
      form.querySelector('input').value = '';
      setTimeout(() => msg.classList.add('hidden'), 5000);
    });
  })();
</script>
