---
import { getCollection } from "astro:content";
import { ChevronLeft, ChevronRight } from "@lucide/astro";

interface Props {
  currentId: string;
}

const { currentId } = Astro.props;

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf()
);

const currentIndex = allPosts.findIndex((p) => p.id === currentId);
const prev = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const next = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
---

{(prev || next) && (
  <nav class="py-12" aria-label="บทความก่อน/ถัดไป">
    <div class="container-page">
      <div class="mx-auto max-w-4xl">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {prev && (
            <a
              href={`/blog/${prev.id}/`}
              class="group flex flex-col rounded-card border border-border/70 bg-white p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-lg dark:border-white/10 dark:bg-white/5"
            >
              <span class="flex items-center gap-1.5 text-xs font-medium text-ink/50 dark:text-white/50">
                <ChevronLeft class="h-4 w-4" />
                บทความก่อนหน้า
              </span>
              <span class="mt-2 text-sm font-bold leading-snug group-hover:text-primary line-clamp-2">
                {prev.data.title}
              </span>
            </a>
          )}
          {next && (
            <a
              href={`/blog/${next.id}/`}
              class="group flex flex-col rounded-card border border-border/70 bg-white p-5 text-right transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-lg dark:border-white/10 dark:bg-white/5 sm:col-start-2"
            >
              <span class="flex items-center justify-end gap-1.5 text-xs font-medium text-ink/50 dark:text-white/50">
                บทความถัดไป
                <ChevronRight class="h-4 w-4" />
              </span>
              <span class="mt-2 text-sm font-bold leading-snug group-hover:text-primary line-clamp-2">
                {next.data.title}
              </span>
            </a>
          )}
        </div>
      </div>
    </div>
  </nav>
)}
