---
import { getCollection } from "astro:content";
import { Calendar, ArrowRight } from "@lucide/astro";

interface Props {
  currentId: string;
  category: string;
  tags: string[];
}

const { currentId, category, tags } = Astro.props;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

const related = allPosts
  .filter((p) => p.id !== currentId)
  .map((p) => ({
    post: p,
    score:
      (p.data.category === category ? 2 : 0) +
      p.data.tags.filter((t) => tags.includes(t)).length,
  }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3);

const fallback = related.length === 0
  ? allPosts
      .filter((p) => p.id !== currentId)
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
      .slice(0, 3)
  : related;

const formatDate = (date: Date) =>
  date.toLocaleDateString("th-TH", { year: "numeric", month: "short", day: "numeric" });

const posts = fallback.map((x) => ("post" in x ? x.post : x));
---

{posts.length > 0 && (
  <section class="py-16">
    <div class="container-page">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-2xl font-extrabold tracking-tight">บทความที่เกี่ยวข้อง</h2>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}/`}
              class="group flex flex-col rounded-card border border-border/70 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/10 dark:border-white/10 dark:bg-white/5"
            >
              <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary w-fit">
                {post.data.category}
              </span>
              <h3 class="mt-3 text-base font-bold leading-snug group-hover:text-primary">
                {post.data.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/60 dark:text-white/60 line-clamp-2">
                {post.data.description}
              </p>
              <div class="mt-4 flex items-center justify-between border-t border-border/60 pt-3 dark:border-white/10">
                <span class="flex items-center gap-1.5 text-xs text-ink/50 dark:text-white/50">
                  <Calendar class="h-3.5 w-3.5" />
                  {formatDate(post.data.publishDate)}
                </span>
                <span class="flex items-center gap-1 text-sm font-semibold text-primary transition-all group-hover:gap-2">
                  อ่าน
                  <ArrowRight class="h-3.5 w-3.5" />
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
