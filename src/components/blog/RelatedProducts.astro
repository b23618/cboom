---
import { Users2, Store, Warehouse, ScanLine, Sparkles, Leaf, ArrowRight } from "@lucide/astro";

interface Props {
  category: string;
  tags: string[];
}

const { category, tags } = Astro.props;

const allProducts = [
  { icon: Users2, name: "CBoom CRM", desc: "บริหารลูกค้าและทีมขายในระบบเดียว", href: "/crm/", keywords: ["CRM", "CRM", "ลูกค้า", "ขาย", "Sales"] },
  { icon: Store, name: "CBoom Marketplace", desc: "รวมออเดอร์จากทุกช่องทาง ซิงค์อัตโนมัติ", href: "/marketplace/", keywords: ["Marketplace", "Shopee", "TikTok", "Lazada", "API", "Marketplace"] },
  { icon: Warehouse, name: "CBoom Warehouse", desc: "จัดการคลังสินค้าหลายสาขา ติดตามสต๊อก Real-time", href: "/inventory/", keywords: ["Warehouse", "Inventory", "สต๊อก", "WMS", "Barcode", "FIFO", "LIFO", "Safety Stock"] },
  { icon: ScanLine, name: "CBoom POS", desc: "จุดขายหน้าร้านเชื่อมต่อสต๊อกและ CRM", href: "/pos/", keywords: ["POS", "หน้าร้าน", "QR Payment", "Cashier", "Receipt"] },
  { icon: Sparkles, name: "CBoom AI", desc: "ผู้ช่วยอัจฉริยะสรุป วิเคราะห์ และแนะนำการขาย", href: "/ai/", keywords: ["AI", "Automation", "Forecast", "Dashboard"] },
  { icon: Leaf, name: "CBoom ESG", desc: "จัดทำรายงานความยั่งยืนและติดตามคาร์บอน", href: "/esg/", keywords: ["ESG", "Carbon", "Sustainability"] },
];

const allTags = [...tags, category];
const scored = allProducts
  .map((p) => ({
    product: p,
    score: p.keywords.filter((k) => allTags.some((t) => t.toLowerCase().includes(k.toLowerCase()) || k.toLowerCase().includes(t.toLowerCase()))).length,
  }))
  .sort((a, b) => b.score - a.score);

const related = (scored[0]?.score > 0 ? scored.filter((x) => x.score > 0) : scored).slice(0, 3).map((x) => x.product);
---

<section class="py-16">
  <div class="container-page">
    <div class="mx-auto max-w-4xl">
      <h2 class="text-2xl font-extrabold tracking-tight">ผลิตภัณฑ์ที่เกี่ยวข้อง</h2>
      <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {related.map((product) => (
          <a
            href={product.href}
            class="group flex flex-col rounded-card border border-border/70 bg-white p-5 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/10 dark:border-white/10 dark:bg-white/5"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-primary to-secondary text-white shadow-md shadow-primary/25">
              <product.icon class="h-5 w-5" />
            </span>
            <h3 class="mt-4 text-base font-bold group-hover:text-primary">{product.name}</h3>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-ink/60 dark:text-white/60">{product.desc}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-all group-hover:gap-2.5">
              ดูรายละเอียด
              <ArrowRight class="h-4 w-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
