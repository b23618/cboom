---
---

<aside id="toc-container" class="hidden lg:block">
  <div class="sticky top-24">
    <div class="rounded-card border border-border/70 bg-white/80 p-5 backdrop-blur-sm dark:border-white/10 dark:bg-white/5">
      <h3 class="text-sm font-bold text-ink dark:text-white">สารบัญ</h3>
      <nav id="toc-nav" class="mt-3 max-h-[60vh] overflow-y-auto pr-2">
        <ul id="toc-list" class="space-y-1 text-sm">
        </ul>
      </nav>
    </div>
  </div>
</aside>

<style is:inline>
  #toc-list a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    color: rgb(30 41 59 / 0.6);
    transition: all 0.2s ease;
    line-height: 1.5;
  }
  .dark #toc-list a {
    color: rgb(255 255 255 / 0.5);
  }
  #toc-list a:hover {
    background: rgb(22 163 74 / 0.08);
    color: #16a34a;
  }
  .dark #toc-list a:hover {
    background: rgb(22 163 74 / 0.15);
  }
  #toc-list a.toc-active {
    background: rgb(22 163 74 / 0.1);
    color: #16a34a;
    font-weight: 600;
  }
  .dark #toc-list a.toc-active {
    background: rgb(22 163 74 / 0.15);
  }
  #toc-list .toc-h3 {
    padding-left: 1.5rem;
    font-size: 0.8125rem;
  }
  #toc-nav::-webkit-scrollbar {
    width: 4px;
  }
  #toc-nav::-webkit-scrollbar-thumb {
    background: rgb(22 163 74 / 0.2);
    border-radius: 4px;
  }
</style>

<script is:inline>
  (function () {
    const article = document.querySelector('.prose-article');
    const tocList = document.getElementById('toc-list');
    if (!article || !tocList) return;

    const headings = article.querySelectorAll('h2, h3');
    if (headings.length === 0) return;

    const items = [];
    headings.forEach((heading, i) => {
      const text = heading.textContent || '';
      if (!text.trim()) return;
      const id = heading.id || `heading-${i}`;
      heading.id = id;
      const level = heading.tagName.toLowerCase();
      items.push({ text: text.trim(), id, level });
    });

    if (items.length === 0) {
      const container = document.getElementById('toc-container');
      if (container) container.style.display = 'none';
      return;
    }

    tocList.innerHTML = items.map(item =>
      `<li><a href="#${item.id}" class="${item.level === 'h3' ? 'toc-h3' : ''}" data-target="${item.id}">${item.text}</a></li>`
    ).join('');

    const links = tocList.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('data-target');
        const target = document.getElementById(targetId);
        if (target) {
          const offset = 100;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach(l => l.classList.remove('toc-active'));
            const activeLink = tocList.querySelector(`a[data-target="${entry.target.id}"]`);
            if (activeLink) activeLink.classList.add('toc-active');
          }
        });
      },
      { rootMargin: '-100px 0px -70% 0px' }
    );

    headings.forEach(h => observer.observe(h));
  })();
</script>
