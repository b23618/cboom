---
import { Sparkles, Bot, FileText, TrendingUp, Lightbulb, Workflow } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProductHero from "../components/ProductHero.astro";
import FeatureList from "../components/FeatureList.astro";
import CTA from "../components/CTA.astro";

const features = [
  { icon: Bot, title: "AI ช่วยสรุปยอดขาย", description: "สรุปยอดขายและภาพรวมธุรกิจให้อ่านง่ายในไม่กี่วินาที" },
  { icon: FileText, title: "AI วิเคราะห์ลูกค้า", description: "เข้าใจพฤติกรรมลูกค้าและโอกาสในการขายได้ลึกขึ้น" },
  { icon: TrendingUp, title: "Forecast", description: "คาดการณ์ยอดขายและแนวโน้มธุรกิจล่วงหน้าด้วย AI" },
  { icon: Lightbulb, title: "AI แนะนำการขาย", description: "รับคำแนะนำเรื่องราคา การเติมสต๊อก และการติดต่อลูกค้า" },
  { icon: Workflow, title: "AI Automation", description: "ให้ AI ทำงานอัตโนมัติเชื่อมกับ CRM มาร์เก็ตเพลส และสต๊อก" },
];
---

<Layout
  title="CBoom AI — ผู้ช่วยธุรกิจอัจฉริยะด้วย AI"
  description="ผู้ช่วย AI สำหรับพยากรณ์ยอดขาย แนะนำการตัดสินใจ และทำงานอัตโนมัติให้ทีมของคุณ"
>
  <Navbar />
  <main>
    <ProductHero
      icon={Sparkles}
      eyebrow="CBoom AI"
      title="ผู้ช่วยอัจฉริยะสำหรับทุกธุรกิจ"
      description="ให้ AI ช่วยสรุปข้อมูลลูกค้า คาดการณ์ยอดขาย และจัดการงานที่ซ้ำซ้อน เพื่อให้ทีมของคุณโฟกัสกับการเติบโต"
    />
    <FeatureList items={features} />
    <CTA />
  </main>
  <Footer />
</Layout>
