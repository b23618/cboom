---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import { Calendar, User, ChevronRight, Clock, RefreshCw } from "@lucide/astro";

import ReadingProgress from "../../components/blog/ReadingProgress.astro";
import ShareButtons from "../../components/blog/ShareButtons.astro";
import TableOfContents from "../../components/blog/TableOfContents.astro";
import AuthorCard from "../../components/blog/AuthorCard.astro";
import RelatedPosts from "../../components/blog/RelatedPosts.astro";
import RelatedProducts from "../../components/blog/RelatedProducts.astro";
import ROICalculator from "../../components/blog/ROICalculator.astro";
import Newsletter from "../../components/blog/Newsletter.astro";
import PrevNextNav from "../../components/blog/PrevNextNav.astro";
import BlogFAQ from "../../components/blog/BlogFAQ.astro";
import DownloadPDF from "../../components/blog/DownloadPDF.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
  date.toLocaleDateString("th-TH", { year: "numeric", month: "long", day: "numeric" });

const formatDateShort = (date: Date) =>
  date.toLocaleDateString("th-TH", { year: "numeric", month: "short", day: "numeric" });

const body = post.body || "";
const charCount = body.length;
const readingTime = Math.max(1, Math.ceil(charCount / 500));

const site = Astro.site ?? new URL("https://cboom.in.th");
const canonicalURL = new URL(`/blog/${post.id}/`, site);

const faqFromArticle = [
  {
    question: "Business Automation Platform ต่างจาก ERP อย่างไร",
    answer:
      "ERP แบบเดิมออกแบบมาสำหรับองค์กรขนาดใหญ่ ติดตั้งนาน ราคาสูง และไม่รองรับการขายบน Marketplace สมัยใหม่ Business Automation Platform ออกแบบมาสำหรับธุรกิจขนาดเล็กถึงกลาง ติดตั้งเร็ว ราคาสมเหตุสมผล และรองรับ Shopee, TikTok Shop และ Lazada โดยตรง",
  },
  {
    question: "ต้องใช้ทุกโมดูลพร้อมกันไหม",
    answer:
      "ไม่จำเป็น สามารถเริ่มจากโมดูลที่แก้ปัญหาเร่งด่วนที่สุดก่อน เช่น Marketplace + Warehouse แล้วเปิด CRM หรือ AI ภายหลังได้ ทุกโมดูลทำงานร่วมกันได้ทันทีที่เปิดใช้งาน",
  },
  {
    question: "ใช้เวลาติดตั้งนานเท่าไร",
    answer:
      "โดยเฉลี่ย 1-3 วันทำการ ขึ้นอยู่กับจำนวนช่องทางและความซับซ้อนของข้อมูล ทีมงาน CBoom พร้อมช่วยติดตั้งและฝึกทีมของคุณให้ใช้งานได้จริง",
  },
  {
    question: "CBoom เชื่อมต่อกับระบบเดิมได้ไหม",
    answer:
      "ได้ CBoom มี REST API และ Webhook สำหรับเชื่อมต่อกับระบบ ERP โปรแกรมบัญชี หรือระบบเดิมของธุรกิจ ทีมงานของเราพร้อมช่วยวางแผนการเชื่อมต่อ",
  },
  {
    question: "ข้อมูลปลอดภัยไหม",
    answer:
      "ข้อมูลเข้ารหัสด้วย AES-256 จัดเก็บใน Data Center ประเทศไทย ปฏิบัติตาม PDPA และมาตรฐาน ISO 27001 มีระบบ Role Permission และ Audit Log สำหรับความปลอดภัยระดับองค์กร",
  },
  {
    question: "มีทดลองใช้งานฟรีไหม",
    answer:
      "มี ทดลองใช้งานฟรี ไม่ต้องใช้บัตรเครดิต สามารถเริ่มใช้งานได้ภายใน 5 นาที พร้อมทีมงานคนไทยดูแลตลอดการใช้งาน",
  },
];

const hasUpdated = post.data.updatedDate && post.data.updatedDate.valueOf() !== post.data.publishDate.valueOf();
---

<Layout
  title={post.data.title}
  description={post.data.description}
  keywords={post.data.keywords}
  image={post.data.image}
  breadcrumb={[{ name: "Blog", path: "/blog/" }, { name: post.data.category, path: `/blog/${post.id}/` }]}
  faq={faqFromArticle}
>
  <ReadingProgress />
  <Navbar />

  <main>
    <!-- Breadcrumb -->
    <div class="container-page pt-8">
      <nav class="flex items-center gap-1.5 text-sm text-ink/50 dark:text-white/50" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary">หน้าแรก</a>
        <ChevronRight class="h-3.5 w-3.5" />
        <a href="/blog/" class="hover:text-primary">Blog</a>
        <ChevronRight class="h-3.5 w-3.5" />
        <span class="text-ink/70 dark:text-white/70">{post.data.category}</span>
      </nav>
    </div>

    <article>
      <!-- Article Header -->
      <header class="container-page pt-8 pb-10">
        <div class="mx-auto max-w-3xl">
          <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
            {post.data.category}
          </span>
          <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
            {post.data.title}
          </h1>
          <p class="mt-4 text-lg leading-relaxed text-ink/60 dark:text-white/60">
            {post.data.description}
          </p>

          <!-- Meta Row -->
          <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-ink/50 dark:text-white/50">
            <span class="flex items-center gap-1.5">
              <User class="h-4 w-4" />
              {post.data.author}
            </span>
            <span class="flex items-center gap-1.5">
              <Calendar class="h-4 w-4" />
              {formatDate(post.data.publishDate)}
            </span>
            <span class="flex items-center gap-1.5">
              <Clock class="h-4 w-4" />
              อ่าน {readingTime} นาที
            </span>
            {hasUpdated && (
              <span class="flex items-center gap-1.5">
                <RefreshCw class="h-4 w-4" />
                อัปเดต {formatDateShort(post.data.updatedDate!)}
              </span>
            )}
          </div>

          <!-- Share Buttons (horizontal, below header) -->
          <div class="mt-6 flex items-center gap-3 border-t border-border/60 pt-5 dark:border-white/10">
            <span class="text-sm font-medium text-ink/50 dark:text-white/50">แชร์:</span>
            <ShareButtons url={canonicalURL.href} title={post.data.title} variant="horizontal" />
          </div>
        </div>
      </header>

      <!-- Article Body + Sidebar -->
      <div class="container-page pb-16">
        <div class="mx-auto max-w-6xl lg:flex lg:gap-10">
          <!-- Main Content -->
          <div class="lg:flex-1 lg:max-w-3xl">
            <div class="prose-article">
              <Content />
            </div>

            <!-- Bottom Share -->
            <div class="mt-10 flex items-center gap-3 border-t border-border/60 pt-6 dark:border-white/10">
              <span class="text-sm font-medium text-ink/50 dark:text-white/50">แชร์บทความนี้:</span>
              <ShareButtons url={canonicalURL.href} title={post.data.title} variant="horizontal" />
            </div>

            <!-- Author Card -->
            <div class="mt-8">
              <AuthorCard author={post.data.author} publishDate={post.data.publishDate} />
            </div>
          </div>

          <!-- Sidebar (TOC + Share + Download) -->
          <aside class="hidden lg:block lg:w-60 lg:flex-shrink-0">
            <div class="sticky top-24 space-y-6">
              <TableOfContents />
              <div class="rounded-card border border-border/70 bg-white/80 p-5 backdrop-blur-sm dark:border-white/10 dark:bg-white/5">
                <h3 class="text-sm font-bold text-ink dark:text-white">แชร์ & ดาวน์โหลด</h3>
                <div class="mt-3">
                  <ShareButtons url={canonicalURL.href} title={post.data.title} variant="horizontal" />
                </div>
                <div class="mt-4 border-t border-border/60 pt-4 dark:border-white/10">
                  <DownloadPDF />
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </article>

    <!-- Related Products -->
    <RelatedProducts category={post.data.category} tags={post.data.tags} />

    <!-- ROI Calculator -->
    <ROICalculator />

    <!-- Related Articles -->
    <RelatedPosts currentId={post.id} category={post.data.category} tags={post.data.tags} />

    <!-- Prev / Next -->
    <PrevNextNav currentId={post.id} />

    <!-- Newsletter -->
    <Newsletter />

    <!-- FAQ Accordion -->
    <BlogFAQ faqs={faqFromArticle} />

    <CTA />
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose-article {
    color: rgb(30 41 59 / 0.8);
  }
  .dark .prose-article {
    color: rgb(255 255 255 / 0.8);
  }
  .prose-article h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #1e293b;
    scroll-margin-top: 100px;
  }
  .dark .prose-article h2 {
    color: #fff;
  }
  .prose-article h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
    scroll-margin-top: 100px;
  }
  .dark .prose-article h3 {
    color: #fff;
  }
  .prose-article p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .prose-article ul {
    margin-bottom: 1rem;
    margin-left: 1.5rem;
    list-style: disc;
  }
  .prose-article ul li {
    margin-top: 0.5rem;
    line-height: 1.75;
  }
  .prose-article ol {
    margin-bottom: 1rem;
    margin-left: 1.5rem;
    list-style: decimal;
  }
  .prose-article ol li {
    margin-top: 0.5rem;
    line-height: 1.75;
  }
  .prose-article a {
    font-weight: 500;
    color: #16a34a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-article a:hover {
    color: #15803d;
  }
  .prose-article blockquote {
    margin: 1.5rem 0;
    border-left: 4px solid #16a34a;
    border-radius: 0 0.5rem 0.5rem 0;
    background: rgb(22 163 74 / 0.05);
    padding: 1rem 1.5rem;
    color: rgb(30 41 59 / 0.7);
  }
  .dark .prose-article blockquote {
    color: rgb(255 255 255 / 0.7);
  }
  .prose-article blockquote p {
    margin-bottom: 0;
  }
  .prose-article table {
    margin: 1.5rem 0;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .prose-article th {
    border: 1px solid rgb(226 232 240);
    background: rgb(255 255 255 / 0.6);
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: #1e293b;
  }
  .dark .prose-article th {
    border-color: rgb(255 255 255 / 0.1);
    background: rgb(255 255 255 / 0.05);
    color: #fff;
  }
  .prose-article td {
    border: 1px solid rgb(226 232 240);
    padding: 0.75rem 1rem;
  }
  .dark .prose-article td {
    border-color: rgb(255 255 255 / 0.1);
  }
  .prose-article code {
    border-radius: 0.25rem;
    background: rgb(22 163 74 / 0.1);
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #16a34a;
  }
  .prose-article pre {
    margin: 1.5rem 0;
    border-radius: 0.75rem;
    border: 1px solid rgb(226 232 240);
    background: #1e293b;
    padding: 1.25rem;
    overflow-x: auto;
  }
  .dark .prose-article pre {
    border-color: rgb(255 255 255 / 0.1);
  }
  .prose-article pre code {
    background: transparent;
    color: #e2e8f0;
    padding: 0;
    font-size: 0.875rem;
  }
  .prose-article img {
    margin: 1.5rem 0;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240);
  }
  .dark .prose-article img {
    border-color: rgb(255 255 255 / 0.1);
  }
  .prose-article hr {
    margin: 2rem 0;
    border-color: rgb(226 232 240);
  }
  .dark .prose-article hr {
    border-color: rgb(255 255 255 / 0.1);
  }
  .prose-article strong {
    font-weight: 700;
    color: #1e293b;
  }
  .dark .prose-article strong {
    color: #fff;
  }
  .prose-article h1 {
    display: none;
  }

  /* Print styles */
  @media print {
    #reading-progress-bar,
    nav[aria-label="Breadcrumb"],
    aside,
    .faq-toggle,
    #newsletter-form,
    #download-pdf-btn,
    #print-article-btn {
      display: none !important;
    }
    .prose-article {
      max-width: 100% !important;
    }
  }
</style>
